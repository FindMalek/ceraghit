{
  "name": "ceraghit",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev -F web -F api",
    "dev:dashboard": "turbo dev -F dashboard -F api",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "turbo test",
    "lint": "biome ci .",
    "check": "biome check --write .",
    "media:manifest": "node scripts/media-manifest.mjs",
    "eval:groq": "bun scripts/translate-eval.ts",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "tutorials:cors": "bun apps/api/scripts/tutorials-cors.ts",
    "tutorials:upload": "bun apps/api/scripts/tutorials-upload.ts",
    "tutorials:upload:production": "bun --no-env-file apps/api/scripts/tutorials-upload.ts --env production --confirm",
    "demo:reset": "scripts/demo-reset.sh",
    "demo:reset:onboarding": "scripts/demo-reset.sh --onboarding",
    "demo:videos": "bun test/demo/run.ts",
    "db:generate": "turbo db:generate -F @workspace/db",
    "db:migrate": "turbo db:migrate -F @workspace/db",
    "db:seed": "turbo db:seed -F @workspace/db",
    "db:seed:catalog": "turbo db:seed:catalog -F @workspace/db",
    "db:studio": "turbo db:studio -F @workspace/db",
    "ui:add": "pnpm --filter @workspace/ui exec shadcn add",
    "licenses:check": "node scripts/check-licenses.mjs",
    "rules:check": "node scripts/check-rules.mjs",
    "e2e": "pnpm --filter @workspace/e2e e2e",
    "e2e:install": "pnpm --filter @workspace/e2e exec playwright install --with-deps chromium webkit",
    "pr:screenshots": "node scripts/pr-screenshots.mjs",
    "start-issue": "scripts/start-issue.sh",
    "db:shell": "scripts/db-shell.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "^2.11.9",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  }
}
