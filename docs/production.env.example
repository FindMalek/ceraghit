# Production values, copy to .env.production.local (gitignored) and fill in. scripts/vercel-setup.sh pushes them to Vercel.
# Nothing here is ever used by previews or local development.

# --- shared by the three apps
WEB_URL=https://ceraghit.com
API_PUBLIC_URL=https://api.ceraghit.com

# --- api
# Neon pooled connection string (the host contains "-pooler")
DATABASE_URL=
# Konnect LIVE keys, only needed once online payment is turned on (ONLINE_PAYMENTS=true, see issue #1). Leave empty for now.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
# Resend (resend.com): verify ceraghit.com there, then use an address on it. onboarding@resend.dev is refused in production
RESEND_API_KEY=
EMAIL_FROM=Ceraghit <commandes@ceraghit.com>
# Cloudflare R2: endpoint is https://<account-id>.r2.cloudflarestorage.com, public url is the bucket's custom domain
S3_ENDPOINT=
S3_BUCKET=ceraghit-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=https://cdn.ceraghit.com

# Long random string, also stored as the CRON_SECRET secret of the GitHub `production` environment (daily photo cleanup)
CRON_SECRET=

# --- web and dashboard: where they reach the api (server side)
API_URL=https://api.ceraghit.com
