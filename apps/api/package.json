{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "start": "bun src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build:vercel": "esbuild src/vercel.ts --bundle --platform=node --target=node22 --format=esm --outfile=api/index.js --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@workspace/db": "workspace:*",
    "@workspace/orpc": "workspace:*",
    "@workspace/sdk": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "esbuild": "^0.28.2",
    "typescript": "catalog:"
  }
}
