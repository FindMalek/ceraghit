{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "start": "bun src/index.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "secrets:rotate": "bun --env-file=../../.env src/rotate-secrets.ts",
    "build:vercel": "rm -rf api && esbuild src/vercel.ts --bundle --platform=node --target=node22 --format=esm --splitting --outdir=api --entry-names=index '--chunk-names=_chunks/[name]-[hash]' --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\""
  },
  "dependencies": {
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@vercel/functions": "catalog:",
    "@workspace/db": "workspace:*",
    "@workspace/errors": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/orpc": "workspace:*",
    "@workspace/sdk": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "esbuild": "^0.28.2",
    "typescript": "catalog:"
  }
}
