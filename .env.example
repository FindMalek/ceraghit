# Copy to .env for local development: cp .env.example .env
APP_ENV=local
DEPLOY_ENV=local

DATABASE_URL=postgres://ceraghit:ceraghit@localhost:5435/ceraghit
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Owner login for the dashboard (created or updated on api start when BOOTSTRAP is on)
ADMIN_EMAIL=owner@ceraghit.local
ADMIN_PASSWORD=change-me-please

# Konnect SANDBOX keys (dashboard.sandbox.konnect.network). Empty = built-in demo checkout. Live keys only in production.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_MODE=test

# Master key of the encrypted credentials vault (provider keys saved in the dashboard): "<version>:<base64 of 32 bytes>".
# Generate: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))". Dev-only value, never reuse one from
# another environment. Empty = the vault is unavailable (saving keys is refused, env values still work).
SECRETS_KEY=
# Only while rotating (docs/secrets.md): the old key, with a lower version than SECRETS_KEY.
SECRETS_KEY_PREVIOUS=

# S3 for uploads: Garage bucket ceraghit-dev locally and on previews, Cloudflare R2 in production. Empty = uploads disabled.
S3_ENDPOINT=https://s3.findmalek.engineer
S3_REGION=garage
S3_BUCKET=ceraghit-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 public url (custom domain) in production; empty means /files redirects to a signed url
S3_PUBLIC_URL=

# Outside production every email goes here instead (your own inbox). Refused in production.
MAIL_REDIRECT_TO=
# Mail catcher started by pnpm db:up, read mails at http://localhost:8025. Empty logs mails to the console. Refused in production.
MAILPIT_URL=http://localhost:8025

# Observability (optional): traces, logs and business metrics to OpenObserve. Unset = nothing is exported.
# Local default is off; see docs/observability/README.md for the service accounts per environment.
OPENOBSERVE_URL=
OPENOBSERVE_ORG=default
OPENOBSERVE_USER=
OPENOBSERVE_PASSWORD=
OPENOBSERVE_STREAM=ceraghit
LOG_LEVEL=debug

# Demo video voiceover: --voice=draft is the free macOS voice (Thomas), --voice=final calls ElevenLabs (paid, default model eleven_flash_v2_5).
TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
ELEVENLABS_CREDIT_BUDGET=
CREDIT_PER_CHAR=
ELEVENLABS_LEDGER=
TTS_CACHE_DIR=
