# Copy to .env for local development: cp .env.example .env
APP_ENV=local
DEPLOY_ENV=local

DATABASE_URL=postgres://ceraghit:ceraghit@localhost:5435/ceraghit
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3001

# Owner login for the dashboard (created or updated on api start when BOOTSTRAP is on)
ADMIN_EMAIL=owner@ceraghit.local
ADMIN_PASSWORD=change-me-please

# Konnect SANDBOX keys (dashboard.sandbox.konnect.network). Empty = built-in demo checkout. Live keys only in production.
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_MODE=test

# S3 for uploads: Garage bucket ceraghit-dev locally and on previews, Cloudflare R2 in production. Empty = uploads disabled.
S3_ENDPOINT=https://s3.findmalek.engineer
S3_REGION=garage
S3_BUCKET=ceraghit-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 public url (custom domain) in production; empty means /files redirects to a signed url
S3_PUBLIC_URL=
