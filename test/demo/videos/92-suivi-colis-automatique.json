    },
    { "action": "wait", "caption_fr": "En démo, Aramex ne répond pas : rien ne change.", "holdMs": 2200 },
    {
      "action": "goto",
      "value": "http://localhost:3070/fr/order/CER-10002?t=demo-2",
      "caption_fr": "Le client voit la même avancée sur sa page.",
      "holdMs": 3200
    },
    {
      "action": "goto",
      "value": "http://localhost:3166/orders?q=CER-10005",
      "caption_fr": "Un colis livré n'a plus besoin de suivi.",
      "holdMs": 800
    },
    { "action": "click", "target": { "text": "CER-10005" }, "caption_fr": "Voici un colis livré." },
    {
      "action": "hover",
      "target": { "text": "Livrée le" },
      "caption_fr": "Statut Livré : plus de bouton Actualiser.",
      "holdMs": 2600
    }
  ]
