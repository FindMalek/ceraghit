{
  "id": "03",
  "slug": "connexion",
  "title_fr": "Se connecter au tableau de bord",
  "start": { "app": "dashboard", "path": "/login", "loggedIn": false },
  "steps": [
    { "action": "wait", "caption_fr": "Voici la page de connexion de votre tableau de bord." },
    {
      "action": "fill",
      "target": { "label": "Email" },
      "value": "{{ADMIN_EMAIL}}",
      "caption_fr": "Saisissez votre adresse email."
    },
    {
      "action": "fill",
      "target": { "label": "Mot de passe" },
      "value": "{{ADMIN_PASSWORD}}",
      "caption_fr": "Puis votre mot de passe."
    },
    {
      "action": "click",
      "target": { "role": "button", "name": "Se connecter" },
      "caption_fr": "Cliquez sur Se connecter."
    },
    {
      "action": "wait",
      "caption_fr": "Vous arrivez sur la vue d'ensemble de vos ventes.",
      "holdMs": 2000
    },
    {
      "action": "hover",
      "target": { "role": "link", "name": "Produits" },
      "caption_fr": "Le menu à gauche donne accès à vos produits.",
      "only": "desktop"
    },
    {
      "action": "tap",
      "target": { "role": "button", "name": "Menu" },
      "caption_fr": "Le menu donne accès à toutes les pages.",
      "only": "mobile"
    }
  ]
}
