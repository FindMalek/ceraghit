      "caption_fr": "Filtrez par statut."
    },
    { "action": "click", "target": { "role": "option", "name": "Publié" }, "caption_fr": "Filtrez par statut." },
    {
      "action": "click",
      "target": { "role": "button", "name": "Ajouter une pièce au stock" },
