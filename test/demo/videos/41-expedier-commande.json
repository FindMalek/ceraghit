      },
      "caption_fr": "Choisissez le transporteur."
    },
    {
      "action": "click",
      "target": {
        "role": "option",
        "name": "Autre transporteur"
      },
      "caption_fr": "Un autre transporteur demande son nom."
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Confirmer l'expédition"
      },
      "caption_fr": "Sans nom, le bouton reste grisé."
    },
    {
      "action": "click",
      "target": {
        "role": "combobox",
        "name": "Transporteur"
      },
      "caption_fr": "Prenons la Poste Tunisienne."
    },
    {
      "action": "click",
      "target": {
        "role": "option",
        "name": "Rapid-Poste"
      },
      "caption_fr": "Prenons la Poste Tunisienne.",
      "holdMs": 600
    },
    {
      "action": "fill",
      "target": {
        "label": "Numéro de suivi"
      },
      "value": "RR123456789TN",
      "caption_fr": "Saisissez le numéro de suivi."
    },
    {
      "action": "fill",
      "target": {
        "label": "Lien de suivi"
      },
      "value": "https://suivi.example.test/RR123456789TN",
      "caption_fr": "Le lien de suivi est facultatif."
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Confirmer l'expédition"
      },
      "caption_fr": "Confirmez l'expédition."
    },
    {
      "action": "wait",
      "caption_fr": "Le client reçoit un email avec le suivi.",
      "holdMs": 1800
