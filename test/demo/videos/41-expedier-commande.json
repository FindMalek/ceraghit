      "only": "desktop",
      "voice": true
    },
    {
      "action": "fill",
      "target": {
        "role": "textbox",
        "name": "Numéro, nom ou email"
      },
      "value": "CER-10013",
      "caption_fr": "Retrouvez la commande à expédier.",
      "only": "mobile",
      "voice": true
    },
    {
      "action": "click",
      "target": {
        "text": "CER-100"
      },
      "caption_fr": "Ouvrez-la d'un clic."
    },
    {
      "action": "click",
      "target": {
        "role": "button",
        "name": "Marquer expédiée"
