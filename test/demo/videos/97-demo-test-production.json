{
  "id": "97",
  "slug": "demo-test-production",
  "title_fr": "Démo, aperçu et production : ne jamais mélanger",
  "devices": ["desktop"],
  "start": { "app": "dashboard", "path": "/payments", "loggedIn": true },
  "steps": [
    {
      "action": "hover",
      "target": { "text": "Mode test (démo)" },
      "caption_fr": "En démo, le paiement est un simulateur.",
      "holdMs": 2600
    },
    {
      "action": "goto",
      "value": "http://localhost:3067/health",
      "caption_fr": "L'API annonce son environnement et sa passerelle.",
      "holdMs": 3600
    },
    {
      "action": "goto",
      "value": "{{DEMO_PAY_URL}}",
      "caption_fr": "Cette page de test n'existe qu'avec la démo.",
      "holdMs": 3200
    },
    {
      "action": "goto",
      "value": "http://localhost:3166/orders?q=CER-10097",
