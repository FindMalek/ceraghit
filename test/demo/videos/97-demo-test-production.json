      "holdMs": 600
    },
    { "action": "click", "target": { "text": "CER-10097" }, "caption_fr": "Ouvrez une commande de démo." },
    {
      "action": "hover",
      "target": { "text": "Démo" },
      "caption_fr": "Démo remplace le nom d'un administrateur.",
      "holdMs": 2600
    },
    {
      "action": "wait",
      "caption_fr": "Les vraies clés, la vraie base et le vrai stockage n'existent qu'en production.",
      "holdMs": 3600
    }
  ]
